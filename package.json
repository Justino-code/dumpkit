{
  "name": "dumpkit",
  "version": "0.2.0",
  "description": "Debugging library for Node.js inspired by Laravel's dump() and dd()",
  "type": "module",

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],

  "repository": {
    "type": "git",
    "url": "git+https://github.com/justino-code/dumpkit.git"
  },

  "bugs": {
    "url": "https://github.com/justino-code/dumpkit/issues"
  },

  "homepage": "https://github.com/justino-code/dumpkit#readme",

  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",

    "typecheck": "tsc --noEmit",

    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",

    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",

    "prepublishOnly": "npm run build"
  },

  "keywords": [
    "debug",
    "dump",
    "dd",
    "inspect",
    "debugging",
    "laravel",
    "nodejs",
    "development",
    "typescript"
  ],

  "author": "Justino Contingo",
  "license": "MIT",

  "engines": {
    "node": ">=22.0.0"
  },

  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.0.0"
  }
}
